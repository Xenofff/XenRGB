<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XenRGB.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="32,24,32,32">
            
            <!-- Page Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="DevicesTitle" Text="Devices" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Manage your OpenRGB hardware, WLED strips, and simulated lighting devices."
                               Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                    <Button Content="+ Add WLED Device" Click="AddWledButton_Click" Style="{ThemeResource AccentButtonStyle}" />
                    <Button x:Name="ScanDevicesButton" Click="ScanDevicesButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="ScanProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="ScanButtonText" Text="Scan Devices" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Backend Status InfoBar -->
            <InfoBar x:Name="BackendStatusInfoBar"
                     IsOpen="True"
                     IsClosable="False"
                     Margin="0,0,0,4" />

            <!-- Empty State View -->
            <Border x:Name="EmptyStateCard"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="36"
                    HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE7F4;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No RGB Devices Detected" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="XenRGB connects to the local OpenRGB SDK server to discover and control real hardware (keyboards, mice, RAM, motherboards, GPUs).&#x0a;&#x0a;To detect your hardware:&#x0a;1. Launch OpenRGB and start the SDK Server (Settings -> OpenRGB Server -> Start Server).&#x0a;2. Click 'Scan Devices' above to discover your devices.&#x0a;&#x0a;You can also click '+ Add WLED Device' to connect Wi-Fi light strips."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="620" />
                </StackPanel>
            </Border>

            <!-- Discovered Devices List -->
            <ItemsControl x:Name="DevicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,12"
                                Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Type Icon -->
                                <Border Width="42" Height="42" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <Border CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="6,2">
                                            <TextBlock Text="{Binding ProviderId}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailsText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Brightness Slider -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Device Brightness" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider Minimum="0" Maximum="100" Value="{Binding BrightnessPercent, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Toggle Switch -->
                                <ToggleSwitch Grid.Column="3" IsOn="{Binding IsEnabled, Mode=TwoWay}" OnContent="Active" OffContent="Off" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Dialog for Adding WLED -->
            <ContentDialog x:Name="AddWledDialog"
                           Title="Add WLED Device"
                           PrimaryButtonText="Connect"
                           CloseButtonText="Cancel"
                           DefaultButton="Primary">
                <StackPanel Spacing="16" Margin="0,12,0,0">
                    <TextBlock Text="Enter the IP address or hostname of your ESP32/ESP8266 running WLED on your local network:"
                               Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBox x:Name="WledIpTextBox" Header="WLED IP Address" PlaceholderText="192.168.1.150" />
                </StackPanel>
            </ContentDialog>

        </StackPanel>
    </ScrollViewer>
</Page>
