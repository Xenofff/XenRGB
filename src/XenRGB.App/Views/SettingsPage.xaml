<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XenRGB.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="32,24,32,32">
            
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Hardware backends, application preferences, and system tray integration."
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- OpenRGB Backend Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="OpenRGB Hardware Backend" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="XenRGB connects to OpenRGB's native network SDK to communicate with motherboards, RAM, GPUs, and peripherals without proprietary vendor bloat."
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="OpenRgbHostBox" Header="Server Host / IP" PlaceholderText="127.0.0.1" />
                        <TextBox Grid.Column="1" x:Name="OpenRgbPortBox" Header="Port" PlaceholderText="6742" />
                        <Button Grid.Column="2" Content="Connect" Click="ConnectOpenRgb_Click" VerticalAlignment="Bottom" Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Performance & Engine -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Engine Performance" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    
                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Target Animation Frame Rate" FontWeight="Medium" />
                            <TextBlock Text="Controls how frequently RGB frames are computed and transmitted to hardware."
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="FpsComboBox" HorizontalAlignment="Right" SelectionChanged="FpsComboBox_SelectionChanged">
                            <ComboBoxItem Content="15 FPS (Ultra-low CPU)" />
                            <ComboBoxItem Content="30 FPS (Standard - Recommended)" />
                            <ComboBoxItem Content="60 FPS (Maximum Smoothness)" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Window & Tray Behavior -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="System Tray" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Minimize to system tray on window close" FontWeight="Medium" />
                            <TextBlock Text="Keeps lighting and automation active in the background when closing the window."
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MinimizeToTrayToggle" HorizontalAlignment="Right" Toggled="MinimizeToTrayToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="About XenRGB" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="XenRGB v1.0.0 — Modern, lightweight open-source RGB lighting controller for Windows."
                               Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="Built with C#, .NET 9, and WinUI 3. Zero bloat, zero cloud dependencies, pure local performance."
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
