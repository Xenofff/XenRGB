<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="XenRGB.App.Views.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="32,24,32,32">
            
            <!-- Page Header -->
            <StackPanel Spacing="4">
                <TextBlock x:Uid="AutomationTitle" Text="Automation" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Configure intelligent lighting control based on display state and system inactivity."
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Monitor State Detection Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Display State Detection" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    
                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Turn off lighting when displays turn off" FontWeight="Medium" />
                            <TextBlock Text="Detects when Windows turns off displays or enters display sleep."
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MonitorOffToggle" HorizontalAlignment="Right" Toggled="SettingChanged" />
                    </Grid>

                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Restore lighting when displays wake up" FontWeight="Medium" />
                            <TextBlock Text="Automatically turns lighting back on when you resume using your monitors."
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RestoreOnWakeToggle" HorizontalAlignment="Right" Toggled="SettingChanged" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Monitor off shutoff delay" FontWeight="Medium" />
                            <TextBlock Text="Wait time before turning off RGB after display signal is cut."
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Slider x:Name="DelaySlider" Width="160" Minimum="0" Maximum="60" StepFrequency="5" ValueChanged="SettingChanged" />
                            <TextBlock x:Name="DelayLabel" Text="10s" Width="40" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Inactivity Timeout Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Inactivity Timeout" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Turn off lighting automatically if no mouse or keyboard activity is detected for a period of time, even if monitors remain active."
                               Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="16" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Inactivity threshold" FontWeight="Medium" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Slider x:Name="InactivitySlider" Width="160" Minimum="0" Maximum="60" StepFrequency="5" ValueChanged="InactivitySlider_ValueChanged" />
                            <TextBlock x:Name="InactivityLabel" Text="15 min" Width="60" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Good Night Mode Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Good Night Mode ☾" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                            <Border x:Name="GoodNightBadge" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                                <TextBlock Text="ACTIVE" FontSize="11" Foreground="#8B5CF6" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Immediately turns off all RGB lighting across all devices while allowing background tasks or downloads to keep running. Lighting remains completely off until you manually restore it."
                                   Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="ToggleGoodNightButton" Content="Activate Good Night" Click="ToggleGoodNight_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
